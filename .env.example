PORT=3000
TMDB_BEARER_TOKEN=your_tmdb_bearer_token

#group_project_backend_3 is the database name
DATABASE_URL=your_database_url
# AUTH_ISSUER: Auth² base URL (no trailing slash). On first mutating request, new users are provisioned via GET {AUTH_ISSUER}/v2/oauth/userinfo. Leave unset for local/tests to provision from JWT claims only (no outbound call).
AUTH_ISSUER=your_auth_issuer
JWT_SECRET=your_jwt_secret_for_local_tests
API_AUDIENCE=group-N-api
CORS_ALLOWED_ORIGINS=your_cors_allowed_origins
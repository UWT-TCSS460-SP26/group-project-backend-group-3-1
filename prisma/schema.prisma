generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum IssueStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

model User {
  id         Int      @id @default(autoincrement())
  email      String
  username   String   @db.VarChar(20)
  role       String   @default("User")

  subjectId  String   @unique  // 👈 auth identity (JWT sub)

  firstName  String   @default("")
  lastName   String   @default("")

  ratings    Rating[]
  reviews    Review[]
}

//Potentially remove composite keys
model Rating {
  ratingId        Int     @id @default(autoincrement())
  /** Local user PK — join to `User.id`. Auth `sub` lives on `User.subjectId`. */
  userId          Int
  isMovie         Boolean
  rating          Int
  tmdbIdentifier  Int

  user            User    @relation(fields: [userId], references: [id])
}

model Review {
  reviewId        Int      @id @default(autoincrement())
  /** Local user PK — join to `User.id`. Auth `sub` lives on `User.subjectId`. */
  userId          Int
  isMovie         Boolean
  dateOfReview    DateTime
  reviewContent   String
  tmdbIdentifier  Int

  user            User     @relation(fields: [userId], references: [id])
}

model Issue {
  issueID         Int   @default(autoincrement())
  issueStatus     Status
  issueDesc       String
  issueReportDate   DateTime  @default(now())

  @@id([issueID])
  
}

enum Status {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}
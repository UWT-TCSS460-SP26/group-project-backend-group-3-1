generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum IssueStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

model User {
  id         Int      @id @default(autoincrement())
  email      String
  username   String   @db.VarChar(20)
  role       String   @default("User")

  subjectId  String   @unique  // 👈 auth identity (JWT sub)

  firstName  String   @default("")
  lastName   String   @default("")

  ratings    Rating[]
  reviews    Review[]
}

//Potentially remove composite keys
model Rating {
  ratingId        Int     @id @default(autoincrement())
  userId          String  
  isMovie         Boolean
  rating          Int
  tmdbIdentifier  Int

  user            User    @relation(fields: [userId], references: [subjectId])
}

model Review {
  reviewId        Int      @id @default(autoincrement())
  userId          String
  isMovie         Boolean
  dateOfReview    DateTime
  reviewContent   String
  tmdbIdentifier  Int

  user            User     @relation(fields: [userId], references: [subjectId])
}

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  email    String
  username String   @db.VarChar(20)
  id       String   @id @default(uuid())
  role     String   @default("user")
  ratings  Rating[]
  reviews  Review[]
}

model Rating {
  ratingId        Int     @default(autoincrement())
  userId          String
  isMovie         Boolean
  rating          Int
  tmdbIdentifier  Int
  user            User    @relation(fields: [userId], references: [id])

  @@id([ratingId, userId])
}

model Review {
  reviewId        Int      @default(autoincrement())
  userId          String
  isMovie         Boolean
  dateOfReview    DateTime
  reviewContent   String
  tmdbIdentifier  Int
  user            User     @relation(fields: [userId], references: [id])

  @@id([reviewId, userId])
}

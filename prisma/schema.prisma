generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  email     String
  username  String   @db.VarChar(20)
  role      String   @default("User")
  firstName String   @default("")
  lastName  String   @default("")
  subjectId String   @unique
  id        Int      @id @default(autoincrement())
  ratings   Rating[]
  reviews   Review[]
}

model Rating {
  ratingId       Int     @id @default(autoincrement())
  isMovie        Boolean
  rating         Int
  tmdbIdentifier Int
  /// * Local user PK — join to `User.id`. Auth `sub` lives on `User.subjectId`.
  userId         Int
  user           User    @relation(fields: [userId], references: [id])
}

model Review {
  reviewId       Int      @id @default(autoincrement())
  isMovie        Boolean
  dateOfReview   DateTime @default(now())
  reviewContent  String
  tmdbIdentifier Int
  /// * Local user PK — join to `User.id`. Auth `sub` lives on `User.subjectId`.
  userId         Int
  user           User     @relation(fields: [userId], references: [id])
}

model Issue {
  issueID         Int      @id @default(autoincrement())
  issueStatus     Status
  issueDesc       String
  issueReportDate DateTime @default(now())
}

enum Status {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}
